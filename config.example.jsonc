{
    // ============================================================
    //  lc-agent 配置文件
    //  复制本文件为 config.jsonc，根据需要修改
    // ============================================================
    // ----- UI -----
    "ui": {
        // 网页左上角显示的应用名称，默认 "lc_agent"
        "app_name": "lc_agent"
    },

    // ----- Token 用量统计 -----
    // enabled=false 只关采集（不再写 llm_usage）；表照建、已落库数据照常可查
    "usage_stats": {
        "enabled": true
    },


    // ----- LLM 供应商 -----
    // 支持配置多个供应商，每个供应商可配置多个模型
    // provider 只是 base_url + api_key 的凭据分组，不参与标识/定价/统计
    "provider": {
        "deepseek": {
            // API Key，支持 {env:ENV_VAR_NAME} 语法读取环境变量
            "api_key": "{env:DEEPSEEK_API_KEY}",
            // API 地址（OpenAI 兼容格式）
            "base_url": "https://api.deepseek.com/v1",
            "models": [
                {
                    // model_id：前端用的全局唯一别名，标识/统计/前端显示用，从不进请求体
                    "model_id": "deepseek-chat",
                    // raw_model_id：渠道期望的真实模型名，请求一律发这个，兼定价兜底 + 统计归并用。
                    // 与 model_id 相同是合法且正确的
                    "raw_model_id": "deepseek-chat",
                    "context_limit": 64000,       // 上下文窗口大小（tokens），对应 LangChain 的 max_input_tokens
                    "max_output_tokens": 65536    // 最大输出 tokens，0 = 不限制
                },
                {
                    "model_id": "deepseek-reasoner",
                    "raw_model_id": "deepseek-reasoner",
                    "context_limit": 64000,
                    "max_output_tokens": 65536
                }
            ]
        }
        // 可以配置多个供应商，如 OpenAI、Anthropic、本地 LiteLLM 等
        // "openai": {
        //     "api_key": "{env:OPENAI_API_KEY}",
        //     "base_url": "https://api.openai.com/v1",
        //     "models": [
        //         {"model_id": "gpt-4o", "raw_model_id": "gpt-4o", "context_limit": 128000, "max_output_tokens": 16384}
        //     ]
        // },
        // "litellm": {
        //     "api_key": "sk-no-key-needed",
        //     "base_url": "http://localhost:4000/v1",
        //     "models": [
        //         // model_id 只是前端别名；请求一律发 raw_model_id，
        //         // 所以 raw_model_id 必须填 litellm 认识的 model_name
        //         {"model_id": "my-model", "raw_model_id": "gpt-4o", "context_limit": 64000, "max_output_tokens": 65536}
        //     ]
        // }
    },

    // ----- Agent 配置 -----
    "agent": {
        // 系统提示词（所有内置预设共用）
        "system_prompt": "你是一个智能助手。请用中文回答。",
        // 默认使用的模型 ID（必须是 provider.models 中已定义的）
        "default_model": "deepseek-chat",
        // 是否启用流式输出
        "streaming": true,
        // LangGraph 图超级步（super-step）上限，不是大模型调用次数：一次模型调用会展开为多个超级步，默认 9999
        "recursion_limit": 9999,
        // 子Agent最大嵌套深度，0 表示禁用子Agent
        "max_subagent_depth": 2,

        // ----- 模型调用重试（SDK 层） -----
        // 模型请求失败（429 / 5xx / 超时 / 连接错误）时由 openai SDK 自动重试的次数，默认 2。
        // 只对"响应开始前"的失败生效；流式吐字中途断流不会重试。范围 0-10，非法值回落默认
        "model_retry": {
            "max_retries": 3
        },

        // ----- 上下文摘要（自动压缩对话历史） -----
        // 当对话超过 trigger 阈值时，自动用 LLM 生成旧消息的摘要，
        // 保留最近 keep 范围的消息原文，避免上下文溢出。
        // 阈值与保留量都按 tiktoken(cl100k_base) 真实编码统计，不用"字符数/4"的近似估算
        //用户需要懂 from langchain.agents.middleware.summarization import SummarizationMiddleware
        "summarization": {
            // 是否启用自动摘要，默认 true
            "enabled": true,
            // 用于生成摘要的模型 ID（留空则使用当前 agent 的模型）
            // 建议使用便宜/快速的模型，如 deepseek-chat
            "default_model": "",
            // 触发阈值：达到此阈值时开始压缩
            // 格式: ["fraction", 0.85] — 达到上下文窗口的 85% 时触发
            //       ["tokens", 50000]  — 达到 50000 tokens 时触发
            //       ["messages", 50]   — 达到 50 条消息时触发
            "trigger": ["fraction", 0.85],
            // 保留策略：压缩后保留多少最近的消息
            // 格式: ["fraction", 0.20] — 保留最近 20% 的上下文窗口
            //       ["messages", 20]   — 保留最近 20 条消息
            //       ["tokens", 5000]   — 保留最近 5000 tokens
            "keep": ["fraction", 0.20]
        }
    },

    // ----- 数据库 -----
    "database": {
        // 对话历史存储（SQLAlchemy async URL）
        // PostgreSQL: "postgresql+asyncpg://user:pass@localhost:5432/lcagent"
        "url": "sqlite+aiosqlite:///./lc_agent_data.db",
        // LangGraph checkpoint 存储路径（SQLite）
        "checkpoint_path": "./lc_agent_checkpoints.db",
        // 可选：填 PostgreSQL URL 则 checkpoint 走 AsyncPostgresSaver，
        // 优先级高于 checkpoint_path。需先安装：pip install "lc-agent-app[postgres]"
        // 注意：LangGraph 官方只提供 sqlite / postgres 两个 saver，没有通用 SQLAlchemy saver
        "checkpoint_url": ""
    },

    "memory": {
        "enabled": true,
        "type": "sqlite",
        "path": "./lc_agent_memory.db",
        "save_policy": "explicit",
        "retrieval_policy": "manual",
        "semantic_search": {
            "enabled": true,
            "api_key": "{env:NBRAG_API_KEY}",
            "base_url": "https://api.siliconflow.cn/v1",
            "model": "BAAI/bge-m3",
            "dims": 1024
        }
    },

    
    // ----- Skills -----
    // 技能扫描目录列表，支持多个目录
    "skills": ["./skills"],

    // ----- lc-agent 自身作为 MCP server -----
    // 与上面的 mcpServers（lc-agent 作为客户端去连别人）方向相反：
    // 这里是把 lc-agent 的 agent 暴露成 MCP 工具，给 Claude Code / Cursor / WorkBuddy 等客户端调用。
    // 端点默认 /mcp；本期无鉴权，开启后服务务必只监听 127.0.0.1。
    // 暴露规则：勾了 can_be_mcp 的 agent 进入目录与调用（与内部委派的 can_be_subagent 独立，
    // 委派描述共用 default_delegation_description；勾选即代表显式授权对外暴露其全部工具能力）。
    // tools/list 每次实时查库，前端改动后客户端重连即见最新，服务不用重启。
    // 调用量统一记到服务用户 auth.service_username（默认 lcagent_as_mcp_user，系统自动创建）头上。
    // "lcagent_as_mcp": {
    //     "enabled": true,
    //     "path": "/mcp"
    // },

    // ----- MCP 配置 -----
    // tool_timeout：单次 MCP 工具调用超时（秒），默认 300。
    // 超时后自动重连再试一次，最坏耗时约 2 倍；非法值（0/负数/非数字）回落 300 并打 warning。
    "mcp": {
        "tool_timeout": 300
    },

    // ----- MCP 服务器 -----
    // 支持 local（stdio）、sse、http 三种传输方式
    "mcpServers": {
        // --- 示例：stdio 本地进程 ---
        // "filesystem": {
        //     "type": "local",
        //     "command": "npx",
        //     "args": ["-y", "@anthropic-ai/mcp-filesystem"],
        //     "env": {},           // 额外环境变量
        //     "enabled": true      // 是否启用，默认 true
        // },

        // --- 示例：SSE 远程服务 ---
        // "remote-search": {
        //     "type": "sse",
        //     "url": "http://localhost:8080/sse",
        //     "enabled": true
        // },

        // --- 示例：Streamable HTTP ---
        // "my-http-mcp": {
        //     "type": "http",
        //     "url": "http://localhost:9090/mcp",
        //     "enabled": true
        // }
    }
}
